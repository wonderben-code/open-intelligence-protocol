{
  "name": "open-intelligence-protocol",
  "version": "0.0.0",
  "private": true,
  "description": "The Open Intelligence Protocol: specifications, test vectors and the v1 reference implementation.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "node scripts/clean.ts",
    "typecheck": "pnpm -r --no-sort --workspace-concurrency=1 exec tsc --noEmit && tsc -p scripts/tsconfig.json --noEmit",
    "lint": "node --max-old-space-size=6144 node_modules/eslint/bin/eslint.js . && prettier --check . && depcruise packages scripts --config .dependency-cruiser.cjs && node scripts/check-guards.ts",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:vectors": "vitest run --project @oip/conformance --reporter=verbose test/vectors.test.ts",
    "test:fuzz": "vitest run fuzz.test",
    "test:differential": "vitest run --project @oip/conformance test/differential",
    "test:differential:logs": "vitest run --project @oip/conformance test/differential.logs.test.ts",
    "test:differential:delegation": "vitest run --project @oip/conformance test/differential.delegation.test.ts",
    "test:differential:network": "vitest run --project @oip/conformance test/differential.network.test.ts",
    "spec:clauses": "node scripts/spec-clauses.ts",
    "spec:coverage": "node scripts/spec-coverage.ts",
    "schemas": "pnpm --filter @oip/schema run generate",
    "generated:check": "node scripts/spec-clauses.ts --check && pnpm --filter @oip/schema run generate --check",
    "api": "pnpm clean && pnpm build && pnpm -r --no-sort --if-present run api",
    "api:check": "pnpm clean && pnpm build && pnpm -r --no-sort --if-present run api:check",
    "bench": "vitest bench --run --reporter=verbose",
    "demo": "node --conditions=@oip/source examples/translation-demo/src/bin.ts",
    "demo:record": "node --conditions=@oip/source examples/translation-demo/src/record.ts",
    "mutation": "stryker run",
    "docs": "typedoc",
    "changeset": "changeset",
    "newcomer": "node scripts/newcomer.ts",
    "mcp:inspector": "node scripts/mcp-inspector.ts",
    "a2a:tck": "node scripts/a2a-tck.ts",
    "ci": "node scripts/ci.ts"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.60.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}

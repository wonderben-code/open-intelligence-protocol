{
  "name": "@oip/cli",
  "version": "0.0.0",
  "description": "The oip command: a mind of the Open Intelligence Protocol, from a terminal.",
  "license": "Apache-2.0",
  "author": "Ekram Alam",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wonderben-code/open-intelligence-protocol.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/wonderben-code/open-intelligence-protocol/tree/main/packages/cli#readme",
  "bugs": "https://github.com/wonderben-code/open-intelligence-protocol/issues",
  "keywords": [
    "oip",
    "open-intelligence-protocol",
    "cli",
    "agent"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@oip/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "api": "api-extractor run --local",
    "api:check": "api-extractor run"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@oip/client": "workspace:*",
    "@oip/core": "workspace:*",
    "@oip/delegation": "workspace:*",
    "@oip/host": "workspace:*",
    "@oip/identity": "workspace:*",
    "@oip/indexer": "workspace:*",
    "@oip/keystore": "workspace:*",
    "@oip/local": "workspace:*",
    "@oip/resolver": "workspace:*",
    "@oip/schema": "workspace:*",
    "@oip/web": "workspace:*"
  },
  "devDependencies": {
    "@oip/testkit": "workspace:*"
  },
  "bin": {
    "oip": "./dist/bin.js"
  }
}

// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`what every command prints > is held, for every command there is 1`] = `
{
  "add-key": "The mind has a new key: <key>
This mind's log has 3 events. Resolvers that have the new one: 1 of 1.
",
  "collective create": "The collective will be did:oip:<mind>
  event      <id>
  signed     did:oip:<mind>
  waiting    did:oip:<mind>
  acts by    2 of 2 members
  delivered  did:oip:<mind>, sealed
It exists once every member has signed: oip collective sign <event>
",
  "collective sign": "The event is <id>
  signed     did:oip:<mind>
  signed     did:oip:<mind>
  acts by    2 of 2 members
The collective is did:oip:<mind>
  log        1 event
",
  "commit": "The Commitment is <id>
  status     proposed
  debtor     did:oip:<mind>: bound
  creditor   did:oip:<mind>: not bound
  delivered  did:oip:<mind>, sealed
",
  "completions": "# oip: completion for bash. Load it with: source <(oip completions bash)
_oip() {
  local cur="\${COMP_WORDS[COMP_CWORD]}"
  local first="\${COMP_WORDS[1]}" second="\${COMP_WORDS[2]}"
  local flags="--dir --json --get --help --version"
  case "$first $second" in
    "publish profile") flags="--name --summary --capability --tag --file --dir --json --get --help --version" ;;
    "publish location") flags="--status --resume-after --ttl --dir --json --get --help --version" ;;
    "publish record") flags="--dir --json --get --help --version" ;;
    "collective create") flags="--member --threshold --host --out --send-to --dir --json --get --help --version" ;;
    "collective sign") flags="--publish --out --send-to --dir --json --get --help --version" ;;
    "keys backup") flags="--replace --dir --json --get --help --version" ;;
    "keys restore") flags="--resolver --indexer --local --network --keychain --dir --json --get --help --version" ;;
    *)
      case "$first" in
        init) flags="--kind --resolver --host --indexer --no-host --local --network --keychain --dir --json --get --help --version" ;;
        show) flags="--dir --json --get --help --version" ;;
        rotate) flags="--dir --json --get --help --version" ;;
        add-key) flags="--label --dir --json --get --help --version" ;;
        revoke-key) flags="--compromised-since --dir --json --get --help --version" ;;
        fork) flags="--kind --host --terms --acknowledge --dir --json --get --help --version" ;;
        resolve) flags="--aliases --local --network --out --dir --json --get --help --version" ;;
        find) flags="--want --tag --kind --limit --local --network --dir --json --get --help --version" ;;
        send) flags="--text --record --verb --goal --reply-to --thread --expires-in --unsealed --dir --json --get --help --version" ;;
        inbox) flags="--all --listen --dir --json --get --help --version" ;;
        intent) flags="--want --deadline --budget --currency --require --audience --expires --for --authority --charter --publish --send-to --dir --json --get --help --version" ;;
        offer) flags="--provides --summary --price --currency --delivery-by --quantity --condition --answers --capability --audience --expires --for --authority --charter --publish --send-to --dir --json --get --help --version" ;;
        commit) flags="--offer --debtor --creditor --witness --promise --deadline --price --currency --payer --payee --resolves --closes-intent --for --authority --charter --publish --send-to --dir --json --get --help --version" ;;
        receipt) flags="--outcome --statement --score --for --authority --charter --publish --send-to --dir --json --get --help --version" ;;
        status) flags="--dir --json --get --help --version" ;;
        delegate) flags="--command --days --expires --not-before --policy --authority --send-to --publish --dir --json --get --help --version" ;;
        revoke) flags="--send-to --dir --json --get --help --version" ;;
        verify) flags="--offline --local --network --dir --json --get --help --version" ;;
        doctor) flags="--dir --json --get --help --version" ;;
        demo) flags="--network --dir --json --get --help --version" ;;
        completions) flags="--dir --json --get --help --version" ;;
      esac ;;
  esac
  if [[ "$cur" == -* ]]; then
    COMPREPLY=($(compgen -W "$flags" -- "$cur"))
  elif [[ $COMP_CWORD -eq 1 ]]; then
    COMPREPLY=($(compgen -W "init show rotate add-key revoke-key fork publish resolve find send inbox intent offer commit receipt status delegate revoke collective verify keys doctor demo completions" -- "$cur"))
  elif [[ $COMP_CWORD -eq 2 ]]; then
    case "$first" in
      publish) COMPREPLY=($(compgen -W "profile location record" -- "$cur")) ;;
      collective) COMPREPLY=($(compgen -W "create sign" -- "$cur")) ;;
      keys) COMPREPLY=($(compgen -W "backup restore" -- "$cur")) ;;
      *) COMPREPLY=($(compgen -f -- "$cur")) ;;
    esac
  else
    COMPREPLY=($(compgen -f -- "$cur"))
  fi
}
complete -F _oip oip
",
  "delegate": "The Delegation is <id>
  delegate   did:oip:<mind>
  may        /oip/sign/Offer
  until      <time>
",
  "demo": "A network is running on this machine:
  resolver  https://resolver.oip.localhost  (http://127.0.0.1:<port>)
  host      https://host.oip.localhost  (http://127.0.0.1:<port>)
  indexer   https://indexer.oip.localhost  (http://127.0.0.1:<port>)
In another terminal, make a mind on it:
  oip init --local
What it holds is kept in <home>/.oip-demo. Stop it with Ctrl-C.
The network has stopped.
",
  "doctor": "  ok         a mind's directory is at <home>/ada
  ok         the network on this machine is running, from <home>/.oip-demo
  ok         the keys are in <home>/ada/keys, sealed with a passphrase
  ok         a backup holds every key
  ok         https://resolver.oip.localhost serves the mind's log: 5 events
  ok         this machine's clock agrees with the resolver's
  ok         https://host.oip.localhost is ready
  ok         the mind is active, at 2 endpoints
  ok         its profile is published: Ada
  ok         https://indexer.oip.localhost is ready
All is well.
",
  "find": "1 found. Indexers that answered: 1 of 1.
1. did:oip:<mind>

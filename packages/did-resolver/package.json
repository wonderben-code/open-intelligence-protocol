{
  "name": "@oip/did-resolver",
  "version": "0.0.0",
  "description": "Resolves did:oip: a driver for the DIF did-resolver library, and a driver for the DIF Universal Resolver.",
  "license": "Apache-2.0",
  "author": "Ekram Alam",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wonderben-code/open-intelligence-protocol.git",
    "directory": "packages/did-resolver"
  },
  "homepage": "https://github.com/wonderben-code/open-intelligence-protocol/tree/main/packages/did-resolver#readme",
  "bugs": "https://github.com/wonderben-code/open-intelligence-protocol/issues",
  "keywords": [
    "oip",
    "open-intelligence-protocol",
    "did",
    "did-resolver",
    "universal-resolver",
    "decentralized-identifiers"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@oip/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "api": "api-extractor run --local",
    "api:check": "api-extractor run"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@oip/client": "workspace:*",
    "@oip/core": "workspace:*",
    "@oip/identity": "workspace:*"
  },
  "devDependencies": {
    "@oip/cli": "workspace:*",
    "@oip/keystore": "workspace:*",
    "@oip/local": "workspace:*",
    "@oip/testkit": "workspace:*",
    "did-resolver": "6.0.0"
  },
  "bin": {
    "oip-did-resolver": "./dist/bin.js"
  }
}

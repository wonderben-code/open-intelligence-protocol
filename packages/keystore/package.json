{
  "name": "@oip/keystore",
  "version": "0.0.0",
  "description": "Encrypted key storage for the Open Intelligence Protocol: a mind's keys kept apart by role, control keys destroyed once used, encrypted backups.",
  "license": "Apache-2.0",
  "author": "Ekram Alam",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wonderben-code/open-intelligence-protocol.git",
    "directory": "packages/keystore"
  },
  "homepage": "https://github.com/wonderben-code/open-intelligence-protocol/tree/main/packages/keystore#readme",
  "bugs": "https://github.com/wonderben-code/open-intelligence-protocol/issues",
  "keywords": [
    "oip",
    "open-intelligence-protocol",
    "keystore",
    "scrypt",
    "xchacha20-poly1305",
    "ed25519"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@oip/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "@oip/source": "./src/node.ts",
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "api": "api-extractor run --local && api-extractor run --local --config api-extractor.node.json",
    "api:check": "api-extractor run && api-extractor run --config api-extractor.node.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@oip/core": "workspace:*",
    "@oip/identity": "workspace:*",
    "@oip/schema": "workspace:*"
  },
  "devDependencies": {
    "@oip/testkit": "workspace:*",
    "fake-indexeddb": "6.2.8"
  }
}

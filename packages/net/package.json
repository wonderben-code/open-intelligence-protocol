{
  "name": "@oip/net",
  "version": "0.0.0",
  "description": "The Mind Network for the Open Intelligence Protocol: feeds and checkpoints, locations and profiles, packets, sessions and sealing.",
  "license": "Apache-2.0",
  "author": "Ekram Alam",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wonderben-code/open-intelligence-protocol.git",
    "directory": "packages/net"
  },
  "homepage": "https://github.com/wonderben-code/open-intelligence-protocol/tree/main/packages/net#readme",
  "bugs": "https://github.com/wonderben-code/open-intelligence-protocol/issues",
  "keywords": [
    "oip",
    "open-intelligence-protocol",
    "feed",
    "checkpoint",
    "packet",
    "session"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@oip/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "api": "api-extractor run --local",
    "api:check": "api-extractor run"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@oip/core": "workspace:*",
    "@oip/identity": "workspace:*",
    "@oip/schema": "workspace:*"
  },
  "devDependencies": {
    "@oip/testkit": "workspace:*"
  }
}

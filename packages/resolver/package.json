{
  "name": "@oip/resolver",
  "version": "0.0.0",
  "description": "The Open Intelligence Protocol resolver: identity logs verified, witnessed and served, with first-seen times and duplicity evidence.",
  "license": "Apache-2.0",
  "author": "Ekram Alam",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wonderben-code/open-intelligence-protocol.git",
    "directory": "packages/resolver"
  },
  "homepage": "https://github.com/wonderben-code/open-intelligence-protocol/tree/main/packages/resolver#readme",
  "bugs": "https://github.com/wonderben-code/open-intelligence-protocol/issues",
  "keywords": [
    "oip",
    "open-intelligence-protocol",
    "resolver",
    "witness"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@oip/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "api": "api-extractor run --local",
    "api:check": "api-extractor run"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@oip/core": "workspace:*",
    "@oip/identity": "workspace:*",
    "@oip/net": "workspace:*",
    "@oip/schema": "workspace:*",
    "@oip/server": "workspace:*"
  },
  "devDependencies": {
    "@oip/testkit": "workspace:*"
  }
}

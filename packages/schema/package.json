{
  "name": "@oip/schema",
  "version": "0.0.0",
  "description": "JSON Schemas, TypeScript types and compiled validators for every Open Intelligence Protocol record.",
  "license": "Apache-2.0",
  "author": "Ekram Alam",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wonderben-code/open-intelligence-protocol.git",
    "directory": "packages/schema"
  },
  "homepage": "https://github.com/wonderben-code/open-intelligence-protocol/tree/main/packages/schema#readme",
  "bugs": "https://github.com/wonderben-code/open-intelligence-protocol/issues",
  "keywords": [
    "oip",
    "open-intelligence-protocol",
    "json-schema",
    "did"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@oip/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate": "node scripts/generate.ts",
    "api": "api-extractor run --local",
    "api:check": "api-extractor run"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "typebox": "^1.4.6"
  },
  "devDependencies": {
    "@oip/testkit": "workspace:*",
    "ajv": "^8.20.0"
  }
}

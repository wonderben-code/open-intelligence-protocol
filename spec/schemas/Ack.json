{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oip:schema:Ack",
  "title": "Ack",
  "description": "A recipient's acknowledgement that it received a packet at a given time (Layer 1, 13.2).",
  "type": "object",
  "required": [
    "oip",
    "created",
    "proof",
    "type",
    "author",
    "packet",
    "received"
  ],
  "properties": {
    "oip": {
      "type": "string",
      "const": "1"
    },
    "ext": {
      "$ref": "urn:oip:schema:def:ext"
    },
    "critical": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "created": {
      "$ref": "urn:oip:schema:def:timestamp"
    },
    "proof": {
      "$ref": "urn:oip:schema:def:proofSet"
    },
    "type": {
      "type": "string",
      "const": "Ack"
    },
    "author": {
      "$ref": "urn:oip:schema:def:mindAddress"
    },
    "packet": {
      "$ref": "urn:oip:schema:def:contentId"
    },
    "received": {
      "$ref": "urn:oip:schema:def:timestamp"
    },
    "sealed": {
      "$ref": "urn:oip:schema:def:contentId"
    }
  }
}

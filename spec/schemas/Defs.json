{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oip:schema:Defs",
  "title": "Defs",
  "description": "Value syntaxes and structures that several record types share (core Sections 1, 3, 4, 6 and 8).",
  "$defs": {
    "timestamp": {
      "$id": "urn:oip:schema:def:timestamp",
      "type": "string",
      "pattern": "^(?:[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z$",
      "maxLength": 30
    },
    "duration": {
      "$id": "urn:oip:schema:def:duration",
      "type": "string",
      "pattern": "^P(?:[0-9]+D(?:T(?:[0-9]+H(?:[0-9]+M)?(?:[0-9]+S)?|[0-9]+M(?:[0-9]+S)?|[0-9]+S))?|T(?:[0-9]+H(?:[0-9]+M)?(?:[0-9]+S)?|[0-9]+M(?:[0-9]+S)?|[0-9]+S))$",
      "maxLength": 64
    },
    "decimal": {
      "$id": "urn:oip:schema:def:decimal",
      "type": "string",
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "maxLength": 64
    },
    "amount": {
      "$id": "urn:oip:schema:def:amount",
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "maxLength": 64
    },
    "unitDecimal": {
      "$id": "urn:oip:schema:def:unitDecimal",
      "type": "string",
      "pattern": "^(?:-0(?:\\.0+)?|0(?:\\.[0-9]+)?|1(?:\\.0+)?)$",
      "maxLength": 64
    },
    "count": {
      "$id": "urn:oip:schema:def:count",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positiveInteger": {
      "$id": "urn:oip:schema:def:positiveInteger",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "safeInteger": {
      "$id": "urn:oip:schema:def:safeInteger",
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "contentId": {
      "$id": "urn:oip:schema:def:contentId",
      "type": "string",
      "pattern": "^bciq[a-p][a-z2-7]{50}[aiqy]$"
    },
    "mindAddress": {
      "$id": "urn:oip:schema:def:mindAddress",
      "type": "string",
      "pattern": "^did:oip:bciq[a-p][a-z2-7]{50}[aiqy]$"
    },
    "versionId": {
      "$id": "urn:oip:schema:def:versionId",
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)-bciq[a-p][a-z2-7]{50}[aiqy]$"
    },
    "versionedMind": {
      "$id": "urn:oip:schema:def:versionedMind",
      "type": "string",
      "pattern": "^did:oip:bciq[a-p][a-z2-7]{50}[aiqy]\\?versionId=(?:0|[1-9][0-9]*)-bciq[a-p][a-z2-7]{50}[aiqy]$"
    },
    "recordRef": {
      "$id": "urn:oip:schema:def:recordRef",
      "type": "string",
      "pattern": "^did:oip:bciq[a-p][a-z2-7]{50}[aiqy]/bciq[a-p][a-z2-7]{50}[aiqy]$"
    },
    "ed25519Multikey": {
      "$id": "urn:oip:schema:def:ed25519Multikey",
      "type": "string",
      "pattern": "^z6Mk[1-9A-HJ-NP-Za-km-z]{44}$"
    },
    "x25519Multikey": {
      "$id": "urn:oip:schema:def:x25519Multikey",
      "type": "string",
      "pattern": "^z6LS[1-9A-HJ-NP-Za-km-z]{44}$"
    },
    "sha256Digest": {
      "$id": "urn:oip:schema:def:sha256Digest",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nonce": {
      "$id": "urn:oip:schema:def:nonce",
      "type": "string",
      "minLength": 8,
      "maxLength": 64
    },
    "httpsOrigin": {
      "$id": "urn:oip:schema:def:httpsOrigin",
      "type": "string",
      "pattern": "^https://[A-Za-z0-9.:\\[\\]-]+$"
    },
    "namespaced": {
      "$id": "urn:oip:schema:def:namespaced",
      "type": "string",
      "pattern": "^[^:]+:.+$"
    },
    "ext": {
      "$id": "urn:oip:schema:def:ext",
      "type": "object",
      "propertyNames": {
        "anyOf": [
          {
            "pattern": "^[a-z0-9-]+(?:\\.[a-z0-9-]+)+$"
          },
          {
            "enum": [
              "x402",
              "ap2",
              "acp",
              "l402",
              "vc",
              "as2"
            ]
          },
          {
            "pattern": "^oip\\."
          }
        ]
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "proofSet": {
      "$id": "urn:oip:schema:def:proofSet",
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 1,
      "maxItems": 256
    },
    "keyController": {
      "$id": "urn:oip:schema:def:keyController",
      "type": "object",
      "required": [
        "keys",
        "next"
      ],
      "properties": {
        "keys": {
          "type": "array",
          "items": {
            "$ref": "urn:oip:schema:def:ed25519Multikey"
          },
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true
        },
        "next": {
          "type": "array",
          "items": {
            "$ref": "urn:oip:schema:def:contentId"
          },
          "maxItems": 16,
          "uniqueItems": true
        },
        "nextThreshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        }
      },
      "additionalProperties": false
    },
    "memberController": {
      "$id": "urn:oip:schema:def:memberController",
      "type": "object",
      "required": [
        "members",
        "threshold"
      ],
      "properties": {
        "members": {
          "type": "array",
          "items": {
            "$ref": "urn:oip:schema:def:mindAddress"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "threshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        }
      },
      "additionalProperties": false
    },
    "controller": {
      "$id": "urn:oip:schema:def:controller",
      "anyOf": [
        {
          "$ref": "urn:oip:schema:def:keyController"
        },
        {
          "$ref": "urn:oip:schema:def:memberController"
        }
      ]
    },
    "signingKeyEntry": {
      "$id": "urn:oip:schema:def:signingKeyEntry",
      "type": "object",
      "required": [
        "key"
      ],
      "properties": {
        "key": {
          "$ref": "urn:oip:schema:def:ed25519Multikey"
        },
        "label": {
          "type": "string",
          "maxLength": 64
        }
      },
      "additionalProperties": false
    },
    "agreementKeyEntry": {
      "$id": "urn:oip:schema:def:agreementKeyEntry",
      "type": "object",
      "required": [
        "key"
      ],
      "properties": {
        "key": {
          "$ref": "urn:oip:schema:def:x25519Multikey"
        },
        "label": {
          "type": "string",
          "maxLength": 64
        }
      },
      "additionalProperties": false
    },
    "capabilityQuery": {
      "$id": "urn:oip:schema:def:capabilityQuery",
      "type": "object",
      "properties": {
        "want": {
          "type": "string",
          "maxLength": 1024
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kinds": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "const": "Participant"
              },
              {
                "type": "string",
                "const": "Offer"
              },
              {
                "type": "string",
                "const": "Intent"
              }
            ]
          }
        },
        "constraints": {
          "type": "object"
        },
        "evidence": {
          "type": "object"
        },
        "limit": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 100
        }
      }
    },
    "evidence": {
      "$id": "urn:oip:schema:def:evidence",
      "type": "object",
      "required": [
        "kind",
        "ref"
      ],
      "properties": {
        "kind": {
          "anyOf": [
            {
              "type": "string",
              "const": "oip"
            },
            {
              "type": "string",
              "const": "uri"
            },
            {
              "type": "string",
              "const": "hash"
            },
            {
              "type": "string",
              "const": "vc"
            },
            {
              "type": "string",
              "const": "payment"
            },
            {
              "type": "string",
              "const": "log"
            },
            {
              "$ref": "urn:oip:schema:def:namespaced"
            }
          ]
        },
        "ref": {
          "type": "string"
        },
        "digest": {
          "$ref": "urn:oip:schema:def:sha256Digest"
        },
        "mediaType": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "ext": {
          "$ref": "urn:oip:schema:def:ext"
        }
      },
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "uri",
              "hash"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "digest"
        ]
      }
    },
    "offerTerms": {
      "$id": "urn:oip:schema:def:offerTerms",
      "type": "object",
      "required": [
        "summary"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "price": {
          "type": "object",
          "required": [
            "amount",
            "currency"
          ],
          "properties": {
            "amount": {
              "$ref": "urn:oip:schema:def:amount"
            },
            "currency": {
              "type": "string"
            }
          }
        },
        "deliveryBy": {
          "$ref": "urn:oip:schema:def:timestamp"
        },
        "quantity": {
          "$ref": "urn:oip:schema:def:positiveInteger"
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "identityEvent": {
      "$id": "urn:oip:schema:def:identityEvent",
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "Genesis",
            "Update",
            "Fork",
            "Retire"
          ]
        }
      },
      "required": [
        "type"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "Genesis"
              }
            }
          },
          "then": {
            "$ref": "urn:oip:schema:Genesis"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "Update"
              }
            }
          },
          "then": {
            "$ref": "urn:oip:schema:Update"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "Fork"
              }
            }
          },
          "then": {
            "$ref": "urn:oip:schema:Fork"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "Retire"
              }
            }
          },
          "then": {
            "$ref": "urn:oip:schema:Retire"
          }
        }
      ]
    }
  }
}

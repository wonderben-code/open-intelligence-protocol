{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oip:schema:Genesis",
  "title": "Genesis",
  "description": "The first event of an identity log (Layer 1, 3.6). Its content ID is the mind's address.",
  "type": "object",
  "required": [
    "oip",
    "created",
    "proof",
    "type",
    "kind",
    "controller"
  ],
  "properties": {
    "oip": {
      "type": "string",
      "const": "1"
    },
    "expires": {
      "$ref": "urn:oip:schema:def:timestamp"
    },
    "ext": {
      "$ref": "urn:oip:schema:def:ext"
    },
    "critical": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created": {
      "$ref": "urn:oip:schema:def:timestamp"
    },
    "proof": {
      "$ref": "urn:oip:schema:def:proofSet"
    },
    "type": {
      "type": "string",
      "const": "Genesis"
    },
    "kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "controller": {
      "$ref": "urn:oip:schema:def:controller"
    },
    "keys": {
      "type": "array",
      "items": {
        "$ref": "urn:oip:schema:def:signingKeyEntry"
      },
      "maxItems": 64
    },
    "invocation": {
      "type": "array",
      "items": {
        "$ref": "urn:oip:schema:def:signingKeyEntry"
      },
      "maxItems": 16
    },
    "agreement": {
      "type": "array",
      "items": {
        "$ref": "urn:oip:schema:def:agreementKeyEntry"
      },
      "maxItems": 16
    },
    "homes": {
      "type": "array",
      "items": {
        "$ref": "urn:oip:schema:def:httpsOrigin"
      },
      "maxItems": 8
    },
    "alsoKnownAs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 16
    },
    "parents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "mind",
          "at"
        ],
        "properties": {
          "mind": {
            "$ref": "urn:oip:schema:def:mindAddress"
          },
          "at": {
            "$ref": "urn:oip:schema:def:versionId"
          }
        },
        "additionalProperties": false
      },
      "maxItems": 16
    },
    "inherits": {
      "type": "object"
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    }
  },
  "not": {
    "anyOf": [
      {
        "required": [
          "mind"
        ]
      },
      {
        "required": [
          "seq"
        ]
      },
      {
        "required": [
          "prev"
        ]
      },
      {
        "required": [
          "recovery"
        ]
      }
    ]
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "collective"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "controller": {
            "required": [
              "members"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "controller": {
            "required": [
              "keys"
            ]
          }
        },
        "required": [
          "controller"
        ]
      },
      "then": {
        "not": {
          "required": [
            "height"
          ]
        }
      }
    }
  ]
}

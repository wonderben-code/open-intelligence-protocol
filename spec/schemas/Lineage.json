{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oip:schema:Lineage",
  "title": "Lineage",
  "description": "A parent's acknowledgement of a child mind, made without its control keys (Layer 1, 8.3).",
  "type": "object",
  "required": [
    "oip",
    "created",
    "proof",
    "type",
    "author",
    "child"
  ],
  "properties": {
    "oip": {
      "type": "string",
      "const": "1"
    },
    "ext": {
      "$ref": "urn:oip:schema:def:ext"
    },
    "critical": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "created": {
      "$ref": "urn:oip:schema:def:timestamp"
    },
    "proof": {
      "$ref": "urn:oip:schema:def:proofSet"
    },
    "type": {
      "type": "string",
      "const": "Lineage"
    },
    "author": {
      "$ref": "urn:oip:schema:def:mindAddress"
    },
    "child": {
      "$ref": "urn:oip:schema:def:mindAddress"
    },
    "terms": {
      "type": "object"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oip:schema:Policy",
  "title": "Policy",
  "description": "A policy: at most 64 statements, all of which must hold for the record being authorised (Layer 1, 11.3).",
  "type": "array",
  "maxItems": 64,
  "items": {
    "$ref": "#/$defs/statement"
  },
  "$defs": {
    "selector": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "anyOf": [
        {
          "type": "array",
          "prefixItems": [
            {
              "enum": [
                "==",
                "!=",
                "<",
                "<=",
                ">",
                ">="
              ]
            },
            {
              "$ref": "#/$defs/selector"
            },
            true
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "not"
            },
            {
              "$ref": "#/$defs/statement"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "enum": [
                "and",
                "or"
              ]
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "$ref": "#/$defs/statement"
              }
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "enum": [
                "all",
                "any"
              ]
            },
            {
              "$ref": "#/$defs/selector"
            },
            {
              "$ref": "#/$defs/statement"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        }
      ]
    }
  }
}

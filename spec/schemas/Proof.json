{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oip:schema:Proof",
  "title": "Proof",
  "description": "One proof of a record's proof set (core 5.2).",
  "type": "object",
  "required": [
    "type",
    "cryptosuite",
    "verificationMethod",
    "proofPurpose",
    "created",
    "proofValue"
  ],
  "properties": {
    "type": {
      "type": "string",
      "const": "DataIntegrityProof"
    },
    "cryptosuite": {
      "type": "string",
      "const": "eddsa-jcs-2022"
    },
    "verificationMethod": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^did:oip:bciq[a-p][a-z2-7]{50}[aiqy]\\?versionId=(?:0|[1-9][0-9]*)-bciq[a-p][a-z2-7]{50}[aiqy]#z[1-9A-HJ-NP-Za-km-z]+$"
        },
        {
          "type": "string",
          "pattern": "^did:key:z[1-9A-HJ-NP-Za-km-z]+#z[1-9A-HJ-NP-Za-km-z]+$"
        }
      ]
    },
    "proofPurpose": {
      "enum": [
        "capabilityInvocation",
        "capabilityDelegation",
        "authentication",
        "assertionMethod"
      ]
    },
    "created": {
      "$ref": "urn:oip:schema:def:timestamp"
    },
    "proofValue": {
      "type": "string",
      "pattern": "^z[1-9A-HJ-NP-Za-km-z]{64,88}$"
    },
    "challenge": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "description": "Exactly one delegation chain, root first (Layer 1, 11.6), or exactly one charter (Layer 2, 7.1).",
      "anyOf": [
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^did:oip:bciq[a-p][a-z2-7]{50}[aiqy]/bciq[a-p][a-z2-7]{50}[aiqy]$"
              },
              {
                "$ref": "urn:oip:schema:Delegation"
              }
            ]
          }
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^did:oip:bciq[a-p][a-z2-7]{50}[aiqy]/bciq[a-p][a-z2-7]{50}[aiqy]$"
              },
              {
                "$ref": "urn:oip:schema:Collective"
              }
            ]
          }
        }
      ]
    },
    "@context": {}
  },
  "additionalProperties": false,
  "dependentSchemas": {
    "challenge": {
      "properties": {
        "proofPurpose": {
          "const": "authentication"
        }
      }
    },
    "domain": {
      "properties": {
        "proofPurpose": {
          "const": "authentication"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oip:schema:Receipt",
  "title": "Receipt",
  "description": "A signed statement about a record, usually about how a Commitment went (Layer 2, 6.1).",
  "type": "object",
  "required": [
    "oip",
    "created",
    "proof",
    "author",
    "type",
    "about",
    "outcome"
  ],
  "properties": {
    "oip": {
      "type": "string",
      "const": "1"
    },
    "expires": {
      "$ref": "urn:oip:schema:def:timestamp"
    },
    "ext": {
      "$ref": "urn:oip:schema:def:ext"
    },
    "critical": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "created": {
      "$ref": "urn:oip:schema:def:timestamp"
    },
    "proof": {
      "$ref": "urn:oip:schema:def:proofSet"
    },
    "author": {
      "$ref": "urn:oip:schema:def:mindAddress"
    },
    "supersedes": {
      "$ref": "urn:oip:schema:def:recordRef"
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rel",
          "ref"
        ],
        "properties": {
          "rel": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          }
        }
      }
    },
    "type": {
      "type": "string",
      "const": "Receipt"
    },
    "about": {
      "$ref": "urn:oip:schema:def:recordRef"
    },
    "outcome": {
      "anyOf": [
        {
          "type": "string",
          "const": "accepted"
        },
        {
          "type": "string",
          "const": "progress"
        },
        {
          "type": "string",
          "const": "fulfilled"
        },
        {
          "type": "string",
          "const": "broken"
        },
        {
          "type": "string",
          "const": "cancelled"
        },
        {
          "type": "string",
          "const": "disputed"
        },
        {
          "type": "string",
          "const": "revoked"
        },
        {
          "$ref": "urn:oip:schema:def:namespaced"
        }
      ]
    },
    "statement": {
      "type": "string",
      "maxLength": 8192
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "urn:oip:schema:def:evidence"
      },
      "maxItems": 64
    },
    "rating": {
      "type": "object",
      "required": [
        "score"
      ],
      "properties": {
        "score": {
          "$ref": "urn:oip:schema:def:unitDecimal"
        }
      }
    }
  },
  "dependentRequired": {
    "status": [
      "supersedes"
    ]
  },
  "if": {
    "properties": {
      "outcome": {
        "const": "revoked"
      }
    },
    "required": [
      "outcome"
    ]
  },
  "then": {
    "required": [
      "supersedes"
    ]
  }
}

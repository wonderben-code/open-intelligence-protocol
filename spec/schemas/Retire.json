{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oip:schema:Retire",
  "title": "Retire",
  "description": "Ends an identity log. No event may follow it (Layer 1, 3.10).",
  "type": "object",
  "required": [
    "oip",
    "created",
    "proof",
    "mind",
    "seq",
    "prev",
    "type"
  ],
  "properties": {
    "oip": {
      "type": "string",
      "const": "1"
    },
    "expires": {
      "$ref": "urn:oip:schema:def:timestamp"
    },
    "ext": {
      "$ref": "urn:oip:schema:def:ext"
    },
    "critical": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created": {
      "$ref": "urn:oip:schema:def:timestamp"
    },
    "proof": {
      "$ref": "urn:oip:schema:def:proofSet"
    },
    "mind": {
      "$ref": "urn:oip:schema:def:mindAddress"
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "prev": {
      "$ref": "urn:oip:schema:def:contentId"
    },
    "controller": {
      "$ref": "urn:oip:schema:def:controller"
    },
    "keys": {
      "type": "array",
      "items": {
        "$ref": "urn:oip:schema:def:signingKeyEntry"
      },
      "maxItems": 64
    },
    "invocation": {
      "type": "array",
      "items": {
        "$ref": "urn:oip:schema:def:signingKeyEntry"
      },
      "maxItems": 16
    },
    "agreement": {
      "type": "array",
      "items": {
        "$ref": "urn:oip:schema:def:agreementKeyEntry"
      },
      "maxItems": 16
    },
    "homes": {
      "type": "array",
      "items": {
        "$ref": "urn:oip:schema:def:httpsOrigin"
      },
      "maxItems": 8
    },
    "alsoKnownAs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 16
    },
    "revoked": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key"
        ],
        "properties": {
          "key": {
            "$ref": "urn:oip:schema:def:ed25519Multikey"
          },
          "compromisedSince": {
            "$ref": "urn:oip:schema:def:timestamp"
          }
        },
        "additionalProperties": false
      },
      "maxItems": 80
    },
    "type": {
      "type": "string",
      "const": "Retire"
    },
    "successor": {
      "$ref": "urn:oip:schema:def:mindAddress"
    },
    "reason": {
      "type": "string"
    }
  },
  "not": {
    "anyOf": [
      {
        "required": [
          "height"
        ]
      },
      {
        "required": [
          "recovery"
        ]
      }
    ]
  },
  "if": {
    "properties": {
      "controller": {
        "required": [
          "keys"
        ]
      }
    },
    "required": [
      "controller"
    ]
  },
  "then": {
    "properties": {
      "controller": {
        "properties": {
          "next": {
            "maxItems": 0
          }
        }
      }
    }
  }
}

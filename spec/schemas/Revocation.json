{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oip:schema:Revocation",
  "title": "Revocation",
  "description": "Revokes a delegation from the revocation's own evaluation time (Layer 1, 11.5).",
  "type": "object",
  "required": [
    "oip",
    "created",
    "proof",
    "type",
    "author",
    "revokes"
  ],
  "properties": {
    "oip": {
      "type": "string",
      "const": "1"
    },
    "expires": {
      "$ref": "urn:oip:schema:def:timestamp"
    },
    "ext": {
      "$ref": "urn:oip:schema:def:ext"
    },
    "critical": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created": {
      "$ref": "urn:oip:schema:def:timestamp"
    },
    "proof": {
      "$ref": "urn:oip:schema:def:proofSet"
    },
    "type": {
      "type": "string",
      "const": "Revocation"
    },
    "author": {
      "$ref": "urn:oip:schema:def:mindAddress"
    },
    "revokes": {
      "$ref": "urn:oip:schema:def:recordRef"
    }
  }
}
